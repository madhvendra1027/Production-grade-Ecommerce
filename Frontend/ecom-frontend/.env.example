# Copy to .env and fill in.
#
# Everything here ends up in the client bundle - Vite replaces import.meta.env.*
# at build time. Only ever put public values in this file. The Stripe
# publishable key (pk_test_... / pk_live_...) is designed to be public; the
# secret key (sk_...) must only ever be set on the backend.

VITE_BACK_END_URL=http://localhost:8080
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
VITE_FRONTEND_URL=http://localhost:5173
