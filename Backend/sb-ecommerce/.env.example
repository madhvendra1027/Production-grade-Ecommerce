# Copy to .env (git-ignored) and fill in, or export these in your shell /
# set them in your run configuration. application.properties reads every one of
# them via ${VAR} placeholders and no longer contains any literal credentials.
#
# Spring Boot does not read .env files on its own. Either export them:
#     set -a && . ./.env && set +a && ./mvnw spring-boot:run
# or paste them into your IDE's environment variables field.

# --- Database (required) ---------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/sb-ecom
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT (required) --------------------------------------------------------
# Base64, at least 32 bytes decoded. Generate with: openssl rand -base64 48
# The old committed secret must be considered compromised - do not reuse it.
JWT_SECRET=
JWT_EXPIRATION_MS=3000000

# Set to true wherever the app is served over HTTPS.
APP_JWT_COOKIE_SECURE=false
# Lax, Strict, or None. None requires Secure=true and re-enabling CSRF tokens.
APP_JWT_COOKIE_SAME_SITE=Lax

# --- Stripe (required) ----------------------------------------------------
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key
PAYMENT_CURRENCY=usd

# --- URLs -----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
IMAGE_BASE_URL=http://localhost:8080/images/

# --- Schema ---------------------------------------------------------------
# validate (default) | update | none. See src/main/resources/db/migration/README.md
DDL_AUTO=validate
FLYWAY_ENABLED=true

# --- Demo accounts (local only) -------------------------------------------
# With APP_SEED_DEMO_USERS=false nothing is seeded. When true, each account is
# only created if its password is set here, so there is never a default
# credential baked into the build.
APP_SEED_DEMO_USERS=false
APP_ADMIN_PASSWORD=
APP_SELLER_PASSWORD=
APP_USER_PASSWORD=

# --- Diagnostics ----------------------------------------------------------
# Turn both off in production; the OpenAPI schema maps every endpoint.
SWAGGER_ENABLED=true
# DEBUG here is noisy and, for the security logger, prints request detail.
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=WARN
LOG_LEVEL_APP=INFO
