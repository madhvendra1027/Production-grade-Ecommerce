CREATE TABLE IF NOT EXISTS roles (
    role_id   integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    role_name varchar(20)
);

CREATE TABLE IF NOT EXISTS users (
    user_id  bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    username varchar(20)  NOT NULL,
    email    varchar(50)  NOT NULL,
    password varchar(120) NOT NULL,
    CONSTRAINT uk_users_username UNIQUE (username),
    CONSTRAINT uk_users_email    UNIQUE (email)
);

-- @ManyToMany join table on User.roles
CREATE TABLE IF NOT EXISTS user_role (
    user_id bigint  NOT NULL REFERENCES users (user_id),
    role_id integer NOT NULL REFERENCES roles (role_id),
    PRIMARY KEY (user_id, role_id)
);

-- @Entity(name = "categories"), so the table takes the entity name
CREATE TABLE IF NOT EXISTS categories (
    category_id   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    category_name varchar(255)
);

-- Product uses GenerationType.AUTO, which Hibernate 6 backs with a sequence
-- rather than an identity column. Every other entity here uses IDENTITY.
CREATE SEQUENCE IF NOT EXISTS products_seq INCREMENT BY 50 START WITH 1;

CREATE TABLE IF NOT EXISTS products (
    product_id    bigint PRIMARY KEY,
    product_name  varchar(255),
    image         varchar(255),
    description   varchar(255),
    quantity      integer,
    price         double precision,
    discount      double precision,
    special_price double precision,
    category_id   bigint REFERENCES categories (category_id),
    seller_id     bigint REFERENCES users (user_id)
);

CREATE TABLE IF NOT EXISTS address (
    id            bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    street_name   varchar(255),
    building_name varchar(255),
    city          varchar(255),
    state         varchar(255),
    country       varchar(255),
    pincode       varchar(255),
    user_id       bigint REFERENCES users (user_id)
);

CREATE TABLE IF NOT EXISTS carts (
    cart_id     bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id     bigint REFERENCES users (user_id),
    total_price double precision
);

CREATE TABLE IF NOT EXISTS cart_items (
    cart_item_id  bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    cart_id       bigint REFERENCES carts (cart_id),
    product_id    bigint REFERENCES products (product_id),
    quantity      integer,
    discount      double precision,
    product_price double precision
);

CREATE TABLE IF NOT EXISTS payments (
    payments_id         bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    payment_method      varchar(255),
    pg_payment_id       varchar(255),
    pg_status           varchar(255),
    pg_response_message varchar(255),
    pg_name             varchar(255)
);

CREATE TABLE IF NOT EXISTS orders (
    order_id     bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    email        varchar(255) NOT NULL,
    order_date   date,
    total_amount double precision,
    order_status varchar(255),
    address_id   bigint REFERENCES address (id),
    payment_id   bigint REFERENCES payments (payments_id)
);

CREATE TABLE IF NOT EXISTS order_items (
    order_item_id         bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    product_id            bigint REFERENCES products (product_id),
    order_id              bigint REFERENCES orders (order_id),
    quantity              integer,
    discount              double precision,
    ordered_product_price double precision
);

-- Supports PaymentRepository.existsByPgPaymentId, the replay guard on checkout.
-- A unique constraint would be better than an index: the same gateway payment
-- should never appear on two orders.
CREATE UNIQUE INDEX IF NOT EXISTS uk_payments_pg_payment_id
    ON payments (pg_payment_id)
    WHERE pg_payment_id IS NOT NULL;
